# Copia este archivo como ".env" y escribe tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# En Render estos valores se escriben en Environment, no en un archivo.

# --- XAMPP / phpMyAdmin local (valores por defecto de XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=juegos_tradicionales
DB_USER=root
DB_PASS=

# --- MySQL en la nube (por ejemplo Aiven): descomenta y cambia ---
# DB_HOST=mysql-xxxx-tuproyecto.aivencloud.com
# DB_PORT=12345
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASS=la-contraseña-que-te-da-el-proveedor
# DB_SSL=true
